pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/temurin-17-jdk-amd64"
        PATH_JAVA = "${JAVA_HOME}/bin"

        IMAGE_NAME = "casepilot"
        CONTAINER_NAME = "casepilot-container"
    }

    stages {

        // ==========================================
        // 1. Checkout Code
        // ==========================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ==========================================
        // 2. Check Java
        // ==========================================
        stage('Check Java') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Checking Java Configuration"
                    echo "=========================================="

                    echo "JAVA_HOME=$JAVA_HOME"

                    which java
                    java -version

                    which javac
                    javac -version

                    echo "=========================================="
                '''
            }
        }

        // ==========================================
        // 3. Give Permission to Gradle Wrapper
        // ==========================================
        stage('Give Permission') {
            steps {
                dir('CasePilot') {
                    sh 'chmod +x gradlew'
                }
            }
        }

        // ==========================================
        // 4. Build Spring Boot Project
        // ==========================================
        stage('Build Project') {
            steps {
                dir('CasePilot') {
                    sh './gradlew clean build'
                }
            }
        }

        // ==========================================
        // 5. Build Docker Image
        // ==========================================
        stage('Build Docker Image') {
            steps {
                dir('CasePilot') {
                    sh 'docker build -t ${IMAGE_NAME}:latest .'
                }
            }
        }

        // ==========================================
        // 6. Stop Old Container
        // ==========================================
        stage('Stop Old Container') {
            steps {
                sh 'docker stop ${CONTAINER_NAME} || true'
            }
        }

        // ==========================================
        // 7. Remove Old Container
        // ==========================================
        stage('Remove Old Container') {
            steps {
                sh 'docker rm ${CONTAINER_NAME} || true'
            }
        }

        // ==========================================
        // 8. Run New Docker Container
        // ==========================================
        stage('Run Docker Image') {
            steps {
                sh '''
                    docker run -d \
                    --name ${CONTAINER_NAME} \
                    -p 8081:8081 \
                    ${IMAGE_NAME}:latest
                '''
            }
        }

        // ==========================================
        // 9. Check Running Container
        // ==========================================
        stage('Check Container') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Running Docker Containers"
                    echo "=========================================="

                    docker ps

                    echo "=========================================="
                    echo "Container Logs"
                    echo "=========================================="

                    docker logs --tail 50 ${CONTAINER_NAME}
                '''
            }
        }

        // ==========================================
        // 10. Application Information
        // ==========================================
        stage('Access Application') {
            steps {
                echo '=========================================='
                echo 'Application deployed successfully!'
                echo 'Application URL: http://localhost:8081'
                echo 'Container Name: casepilot-container'
                echo '=========================================='
            }
        }
    }

    // ==========================================
    // Post Actions
    // ==========================================
    post {

        success {
            echo '=========================================='
            echo 'Build Successful!'
            echo 'Docker deployment completed successfully.'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'Build Failed!'
            echo 'Please check the Jenkins console logs.'
            echo '=========================================='
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}